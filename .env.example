
# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ppt_agent
DB_USER=root
DB_PASSWORD=your_password

# ========== LLM 配置 ==========
# 选择 LLM 提供商: openai / anthropic / mimo / deepseek / qwen
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 小米 MiMo
MIMO_API_KEY=your_key_here
MIMO_API_BASE=https://api.mimov2.example.com/v1
MIMO_MODEL=mimo-v2.5

# DeepSeek
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=deepseek-chat

# 通义千问
QWEN_API_KEY=your_key_here
QWEN_MODEL=qwen-plus

# ========== Embedding 配置 ==========
# embedding 提供商: openai / huggingface
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ========== 文件存储 ==========
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# ========== 向量库 ==========
CHROMA_DIR=./chroma_db

# ========== RAG 配置 ==========
DEFAULT_RAG_STRATEGY=basic
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
